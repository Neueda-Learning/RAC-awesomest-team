# Maven build output
/backend/target/

# IntelliJ IDEA
/.idea/
/*.iml
/out/

# If you want to share code style / inspections / run configs, keep these:
#!/.idea/codeStyles/
/!/.idea/inspectionProfiles/
/!/.idea/runConfigurations/

# Logs
*.log

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Crash / JVM diagnostic files
hs_err_pid*
replay_pid*

# Env / secrets (按你项目情况启用)
.env
.env.*
application-local.properties
application-dev.properties

# Project notes and local documentation
/notes/

# IntelliJ shared settings allowlist (add-only override)
!.idea/
.idea/*
!.idea/codeStyles/
!.idea/codeStyles/**
!.idea/inspectionProfiles/
!.idea/inspectionProfiles/**
!.idea/runConfigurations/
!.idea/runConfigurations/**

